{
    "applications": {
        "_comment": [
            "Fields - application key id\n",
            "Support application subfields:\n",
            "> \"path\" - path to application (Required)\n",
            "> \"param\" - \"string\" or \"array of string\" of params for application (Optional)\n",
            "> \"title\" - user friendly application title (Required)\n",
            "> \"icon\" - icon name in theme or object path (Optional)\n",
            "> \"focused icon\" - name of icon with focus in theme or object path (Optional)\n",
            "> \"visible\" - show application in application list (Optional) (\"1\" as default)\n",
            "> \"hideInAccessibility\" - hide application in accessibility mode (Optional)\n",
            "Support fields values type:\n",
            "> \"string value\" - end value\n",
            "> \"object path\" - end value { \"path\": \"<path on user space>\"}\n",
            "> \"device\" - object with values separated by field deviceID (e.g. \"all\", \"notouch\", \"626\", \"632\", \"740-2\" etc)\n",
            "> \"partner\" - object with values separated by field customizer partner (e.g. \"tea\", \"knv\", \"legimi\" etc)\n",
            "> \"has_audio\" - object with values separated by exist audio (\"all\", \"false\", \"true\")\n",
            "> \"localization\" - object with values separated by field localization (e.g. \"WW\", \"RU\", \"CIS\")\n",
            "> \"language\" - object with values separated by device languages (e.g. \"en\", \"ru\", \"de\")\n",
            "> \"has_cloud\" - object with values separated by exist cloud (\"all\", \"false\", \"true\")\n",
            "> \"globalcfg\" - object with values separated by key-value from global.cfg (any key-name from \"global.cfg\", objects from values of key. \"default\" - value not set)\n",
            "Different objects value use only as named subobjects\n",
            "Objects value must have field \"all\" with default value\n",
            "Examples:\n",
            "1) \"visible\": {\n",
            "     \"device\": {\n",
            "       \"all\": \"1\",\n",
            "       \"632\": \"0\",\n",
            "       \"1040\": \"0\"\n",
            "     }\n",
            "   }\n",
            "2) \"visible\": {\n",
            "     \"device\": {\n",
            "       \"all\": \"1\",\n",
            "       \"632\": {\n",
            "         \"partner\": {\n",
            "           \"all\": \"1\",\n",
            "           \"umbreit\": \"0\"\n",
            "       }\n",
            "     }\n",
            "   }\n",
            "3) \"visible\": {\n",
            "     \"partner\": {\n",
            "       \"all\": \"0\",\n",
            "       \"legimi\": {\n",
            "         \"device\": {\n",
            "           \"all\": \"1\",\n",
            "           \"740\": \"0\"\n",
            "       }\n",
            "     }\n",
            "   }\n",
            "end."
        ],
